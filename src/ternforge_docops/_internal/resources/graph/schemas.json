{
  "$defs": {
    "type-goal": {"properties": {"type": {"const": "goal"}}},
    "type-feature": {"properties": {"type": {"const": "feature"}}},
    "type-req": {"properties": {"type": {"const": "req"}}},
    "type-treq": {"properties": {"type": {"const": "treq"}}},
    "type-adr": {"properties": {"type": {"const": "adr"}}},
    "type-exp": {"properties": {"type": {"const": "exp"}}},
    "type-impl": {"properties": {"type": {"const": "impl"}}},
    "type-producer": {"properties": {"type": {"const": "producer"}}},
    "type-qualification": {"properties": {"type": {"const": "qualification"}}},
    "type-manual": {"properties": {"type": {"const": "manual"}}},
    "type-testcase": {"properties": {"type": {"const": "testcase"}}},
    "trust-evidence": {
      "properties": {"type": {"enum": ["qualification", "manual"]}}
    },
    "calibration-evidence": {
      "properties": {"type": {"enum": ["qualification", "manual", "exp"]}}
    },
    "requirement-like": {
      "properties": {"type": {"enum": ["req", "treq"]}}
    },
    "decision-affectable": {
      "properties": {"type": {"enum": ["feature", "req", "treq", "impl"]}}
    },
    "experiment-informed-target": {
      "properties": {"type": {"enum": ["adr", "req", "treq"]}}
    }
  },
  "schemas": [
    {
      "id": "goal-id",
      "message": "Goal IDs must use the GOAL_ prefix.",
      "select": {"$ref": "#/$defs/type-goal"},
      "validate": {"local": {"properties": {"id": {"pattern": "^GOAL_[A-Z0-9_]+$"}}}}
    },
    {
      "id": "goal-decomposition",
      "message": "A goal must be decomposed by at least one capability.",
      "select": {"$ref": "#/$defs/type-goal"},
      "validate": {
        "network_back": {
          "derives": {
            "contains": {"local": {"$ref": "#/$defs/type-feature"}},
            "items": {"local": {"$ref": "#/$defs/type-feature"}},
            "minContains": 1
          }
        }
      }
    },
    {
      "id": "feature-id-and-parent",
      "message": "A capability must have a FEAT_ ID and derive from exactly one goal.",
      "select": {"$ref": "#/$defs/type-feature"},
      "validate": {
        "local": {"properties": {"id": {"pattern": "^FEAT_[A-Z0-9_]+$"}}},
        "network": {
          "derives": {
            "contains": {"local": {"$ref": "#/$defs/type-goal"}},
            "items": {"local": {"$ref": "#/$defs/type-goal"}},
            "minContains": 1,
            "maxContains": 1
          }
        }
      }
    },
    {
      "id": "feature-decomposition",
      "message": "A capability must be decomposed by at least one requirement.",
      "select": {"$ref": "#/$defs/type-feature"},
      "validate": {
        "network_back": {
          "derives": {
            "contains": {"local": {"$ref": "#/$defs/type-req"}},
            "items": {"local": {"$ref": "#/$defs/type-req"}},
            "minContains": 1
          }
        }
      }
    },
    {
      "id": "req-contract",
      "message": "A requirement must have a REQ_ ID, lifecycle status, revision, required evidence, and exactly one capability parent.",
      "select": {"$ref": "#/$defs/type-req"},
      "validate": {
        "local": {
          "properties": {
            "id": {"pattern": "^REQ_[A-Z0-9_]+$"},
            "status": {"enum": ["draft", "accepted", "deprecated"]},
            "revision": {},
            "required_evidence": {"items": {}, "minItems": 1}
          },
          "required": ["status", "revision", "required_evidence"]
        },
        "network": {
          "derives": {
            "contains": {"local": {"$ref": "#/$defs/type-feature"}},
            "items": {"local": {"$ref": "#/$defs/type-feature"}},
            "minContains": 1,
            "maxContains": 1
          }
        }
      }
    },
    {
      "id": "treq-contract",
      "message": "A technical requirement must have a TREQ_ ID, lifecycle status, revision, required evidence, and exactly one requirement parent.",
      "select": {"$ref": "#/$defs/type-treq"},
      "validate": {
        "local": {
          "properties": {
            "id": {"pattern": "^TREQ_[A-Z0-9_]+$"},
            "status": {"enum": ["draft", "accepted", "deprecated"]},
            "revision": {},
            "required_evidence": {"items": {}, "minItems": 1}
          },
          "required": ["status", "revision", "required_evidence"]
        },
        "network": {
          "derives": {
            "contains": {"local": {"$ref": "#/$defs/type-req"}},
            "items": {"local": {"$ref": "#/$defs/type-req"}},
            "minContains": 1,
            "maxContains": 1
          }
        }
      }
    },
    {
      "id": "adr-contract",
      "message": "An architecture decision must have an ADR_#### ID, decision lifecycle, decision date, minimal decision record sections, and only valid impact links.",
      "select": {"$ref": "#/$defs/type-adr"},
      "validate": {
        "local": {
          "properties": {
            "id": {"pattern": "^ADR_[0-9]{4}$"},
            "status": {"enum": ["proposed", "accepted", "rejected", "deprecated", "superseded"]},
            "decision_date": {},
            "content": {"pattern": "\\*\\*Context\\.\\*\\*[\\s\\S]+\\*\\*Decision\\.\\*\\*[\\s\\S]+\\*\\*Consequences\\.\\*\\*[\\s\\S]+\\*\\*Alternatives considered\\.\\*\\*[\\s\\S]+"},
            "derives": {"maxItems": 0},
            "implements": {"maxItems": 0},
            "verifies": {"maxItems": 0}
          },
          "required": ["status", "decision_date", "content"]
        },
        "network": {
          "affects": {"items": {"local": {"$ref": "#/$defs/decision-affectable"}}},
          "supersedes": {"items": {"local": {"$ref": "#/$defs/type-adr"}}}
        }
      }
    },
    {
      "id": "adr-supersedes-contract",
      "message": "Only an accepted architecture decision may supersede another decision, and every target must already be marked superseded.",
      "select": {"properties": {"type": {"const": "adr"}, "supersedes": {"items": {}, "minItems": 1}}, "required": ["supersedes"]},
      "validate": {
        "local": {"properties": {"status": {"const": "accepted"}}},
        "network": {"supersedes": {"items": {"local": {"properties": {"type": {"const": "adr"}, "status": {"const": "superseded"}}, "required": ["status"]}}}}
      }
    },
    {
      "id": "adr-superseded-contract",
      "message": "A superseded architecture decision must be replaced by exactly one accepted architecture decision.",
      "select": {"properties": {"type": {"const": "adr"}, "status": {"const": "superseded"}}, "required": ["status"]},
      "validate": {
        "network_back": {
          "supersedes": {
            "contains": {"local": {"properties": {"type": {"const": "adr"}, "status": {"const": "accepted"}}, "required": ["status"]}},
            "items": {"local": {"$ref": "#/$defs/type-adr"}},
            "minContains": 1,
            "maxContains": 1
          }
        }
      }
    },
    {
      "id": "affects-source-contract",
      "message": "The affects relation is reserved for architecture decisions.",
      "select": {"properties": {"affects": {"items": {}, "minItems": 1}}, "required": ["affects"]},
      "validate": {"local": {"properties": {"type": {"const": "adr"}}}}
    },
    {
      "id": "supersedes-source-contract",
      "message": "The supersedes relation is reserved for architecture decisions.",
      "select": {"properties": {"supersedes": {"items": {}, "minItems": 1}}, "required": ["supersedes"]},
      "validate": {"local": {"properties": {"type": {"const": "adr"}}}}
    },
    {
      "id": "experiment-contract",
      "message": "An engineering experiment must have an EXP_#### ID, date, and only valid informed targets; its Question and Answer live once in the retained report narrative.",
      "select": {"$ref": "#/$defs/type-exp"},
      "validate": {
        "local": {
          "properties": {
            "id": {"pattern": "^EXP_[0-9]{4}$"},
            "experiment_date": {},
            "derives": {"maxItems": 0},
            "implements": {"maxItems": 0},
            "verifies": {"maxItems": 0},
            "affects": {"maxItems": 0},
            "supersedes": {"maxItems": 0}
          },
          "required": ["experiment_date"]
        },
        "network": {
          "informs": {"items": {"local": {"$ref": "#/$defs/experiment-informed-target"}}}
        }
      }
    },
    {
      "id": "informs-source-contract",
      "message": "The informs relation is reserved for engineering experiments.",
      "select": {"properties": {"informs": {"items": {}, "minItems": 1}}, "required": ["informs"]},
      "validate": {"local": {"properties": {"type": {"const": "exp"}}}}
    },
    {
      "id": "producer-contract",
      "message": "An evidence producer must declare purpose, impact, risk, residual doubt, and at least one trust-basis record.",
      "select": {"$ref": "#/$defs/type-producer"},
      "validate": {
        "local": {
          "properties": {
            "id": {"pattern": "^PRODUCER_[A-Z0-9_]+$"},
            "producer_role": {},
            "producer_version": {"minLength": 1},
            "producer_impact": {},
            "producer_purpose": {"minLength": 1},
            "risk_if_wrong": {"minLength": 1},
            "residual_doubt": {"minLength": 1},
            "derives": {"maxItems": 0},
            "implements": {"maxItems": 0},
            "verifies": {"maxItems": 0}
          },
          "required": ["producer_role", "producer_version", "producer_impact", "producer_purpose", "risk_if_wrong", "residual_doubt"]
        },
        "network": {
          "qualified_by": {
            "contains": {"local": {"$ref": "#/$defs/trust-evidence"}},
            "items": {"local": {"$ref": "#/$defs/trust-evidence"}},
            "minContains": 1
          }
        }
      }
    },
    {
      "id": "high-impact-producer-trust",
      "message": "A high-impact evidence producer must have at least two independent trust-basis records.",
      "select": {
        "properties": {
          "type": {"const": "producer"},
          "producer_impact": {"const": "high"}
        },
        "required": ["producer_impact"]
      },
      "validate": {
        "network": {
          "qualified_by": {
            "contains": {"local": {"$ref": "#/$defs/trust-evidence"}},
            "items": {"local": {"$ref": "#/$defs/trust-evidence"}},
            "minContains": 2
          }
        }
      }
    },
    {
      "id": "qualification-contract",
      "message": "Producer qualification must identify a concrete trust mechanism, target version, and retained evidence URL.",
      "select": {"$ref": "#/$defs/type-qualification"},
      "validate": {
        "local": {
          "properties": {
            "id": {"pattern": "^QUAL_[A-Z0-9_]+$"},
            "qualification_kind": {},
            "target_version": {"minLength": 1},
            "evidence_url": {"minLength": 1},
            "derives": {"maxItems": 0},
            "implements": {"maxItems": 0},
            "verifies": {"maxItems": 0}
          },
          "required": ["qualification_kind", "target_version", "evidence_url"]
        }
      }
    },
    {
      "id": "manual-verification-contract",
      "message": "Manual verification must retain date, target version, performer, artifact, scope, and limitation.",
      "select": {"$ref": "#/$defs/type-manual"},
      "validate": {
        "local": {
          "properties": {
            "id": {"pattern": "^MANUAL_[A-Z0-9_]+$"},
            "manual_date": {},
            "target_version": {"minLength": 1},
            "performed_by": {"minLength": 1},
            "artifact_url": {"minLength": 1},
            "manual_scope": {"minLength": 1},
            "limitation": {"minLength": 1},
            "derives": {"maxItems": 0},
            "implements": {"maxItems": 0},
            "verifies": {"maxItems": 0}
          },
          "required": ["manual_date", "target_version", "performed_by", "artifact_url", "manual_scope", "limitation"]
        }
      }
    },
    {
      "id": "produced-by-source-contract",
      "message": "Only imported testcase evidence may declare evidence producers, and every target must be an evidence producer.",
      "select": {"properties": {"produced_by": {"items": {}, "minItems": 1}}, "required": ["produced_by"]},
      "validate": {
        "local": {"$ref": "#/$defs/type-testcase"},
        "network": {
          "produced_by": {
            "contains": {"local": {"$ref": "#/$defs/type-producer"}},
            "items": {"local": {"$ref": "#/$defs/type-producer"}},
            "minContains": 1
          }
        }
      }
    },
    {
      "id": "qualified-by-source-contract",
      "message": "Trust-basis relations originate from evidence producers and target qualification/manual evidence.",
      "select": {"properties": {"qualified_by": {"items": {}, "minItems": 1}}, "required": ["qualified_by"]},
      "validate": {
        "local": {"$ref": "#/$defs/type-producer"},
        "network": {
          "qualified_by": {
            "items": {"local": {"$ref": "#/$defs/trust-evidence"}}
          }
        }
      }
    },
    {
      "id": "calibrated-by-source-contract",
      "message": "Calibration relations originate from evidence producers and target EXP/manual/qualification evidence.",
      "select": {"properties": {"calibrated_by": {"items": {}, "minItems": 1}}, "required": ["calibrated_by"]},
      "validate": {
        "local": {"$ref": "#/$defs/type-producer"},
        "network": {
          "calibrated_by": {
            "items": {"local": {"$ref": "#/$defs/calibration-evidence"}}
          }
        }
      }
    },
    {
      "id": "calibrates-source-contract",
      "message": "Calibration evidence may extend a package-owned producer through the calibrates relation.",
      "select": {"properties": {"calibrates": {"items": {}, "minItems": 1}}, "required": ["calibrates"]},
      "validate": {
        "local": {"$ref": "#/$defs/calibration-evidence"},
        "network": {
          "calibrates": {
            "items": {"local": {"$ref": "#/$defs/type-producer"}}
          }
        }
      }
    },
    {
      "id": "impl-contract",
      "message": "Implementation evidence must come from source code and implement at least one requirement.",
      "select": {"$ref": "#/$defs/type-impl"},
      "validate": {
        "local": {
          "properties": {
            "id": {"pattern": "^IMPL_[A-Z0-9_]+$"},
            "source_url": {"type": "string", "minLength": 1}
          },
          "required": ["source_url"]
        },
        "network": {
          "implements": {
            "contains": {"local": {"$ref": "#/$defs/requirement-like"}},
            "items": {"local": {"$ref": "#/$defs/requirement-like"}},
            "minContains": 1
          }
        }
      }
    },
    {
      "id": "traced-testcase-contract",
      "message": "Traced verification evidence must pass and verify at least one requirement.",
      "select": {
        "properties": {
          "type": {"const": "testcase"},
          "verification_kind": {"enum": ["bdd", "unit", "property", "integration", "e2e"]}
        },
        "required": ["verification_kind"]
      },
      "validate": {
        "local": {
          "properties": {"result": {"const": "passed"}},
          "required": ["result"]
        },
        "network": {
          "verifies": {
            "contains": {"local": {"$ref": "#/$defs/requirement-like"}},
            "items": {"local": {"$ref": "#/$defs/requirement-like"}},
            "minContains": 1
          }
        }
      }
    },
    {
      "id": "requested-impl",
      "message": "A requirement requesting implementation evidence must have implementation coverage.",
      "select": {
        "properties": {
          "type": {"enum": ["req", "treq"]},
          "status": {"const": "accepted"},
          "required_evidence": {"items": {}, "contains": {"const": "impl"}}
        },
        "required": ["status", "required_evidence"]
      },
      "validate": {
        "network_back": {
          "implements": {
            "contains": {"local": {"$ref": "#/$defs/type-impl"}},
            "minContains": 1
          }
        }
      }
    },
    {
      "id": "requested-bdd",
      "message": "A requirement requesting BDD evidence must have BDD coverage.",
      "select": {"properties": {"type": {"enum": ["req", "treq"]}, "status": {"const": "accepted"}, "required_evidence": {"items": {}, "contains": {"const": "bdd"}}}, "required": ["status", "required_evidence"]},
      "validate": {"network_back": {"verifies": {"contains": {"local": {"properties": {"type": {"const": "testcase"}, "verification_kind": {"const": "bdd"}}, "required": ["verification_kind"]}}, "minContains": 1}}}
    },
    {
      "id": "requested-unit",
      "message": "A requirement requesting unit evidence must have unit coverage.",
      "select": {"properties": {"type": {"enum": ["req", "treq"]}, "status": {"const": "accepted"}, "required_evidence": {"items": {}, "contains": {"const": "unit"}}}, "required": ["status", "required_evidence"]},
      "validate": {"network_back": {"verifies": {"contains": {"local": {"properties": {"type": {"const": "testcase"}, "verification_kind": {"const": "unit"}}, "required": ["verification_kind"]}}, "minContains": 1}}}
    },
    {
      "id": "requested-property",
      "message": "A requirement requesting property evidence must have property coverage.",
      "select": {"properties": {"type": {"enum": ["req", "treq"]}, "status": {"const": "accepted"}, "required_evidence": {"items": {}, "contains": {"const": "property"}}}, "required": ["status", "required_evidence"]},
      "validate": {"network_back": {"verifies": {"contains": {"local": {"properties": {"type": {"const": "testcase"}, "verification_kind": {"const": "property"}}, "required": ["verification_kind"]}}, "minContains": 1}}}
    },
    {
      "id": "requested-integration",
      "message": "A requirement requesting integration evidence must have integration coverage.",
      "select": {"properties": {"type": {"enum": ["req", "treq"]}, "status": {"const": "accepted"}, "required_evidence": {"items": {}, "contains": {"const": "integration"}}}, "required": ["status", "required_evidence"]},
      "validate": {"network_back": {"verifies": {"contains": {"local": {"properties": {"type": {"const": "testcase"}, "verification_kind": {"const": "integration"}}, "required": ["verification_kind"]}}, "minContains": 1}}}
    },
    {
      "id": "requested-e2e",
      "message": "A requirement requesting E2E evidence must have E2E coverage.",
      "select": {"properties": {"type": {"enum": ["req", "treq"]}, "status": {"const": "accepted"}, "required_evidence": {"items": {}, "contains": {"const": "e2e"}}}, "required": ["status", "required_evidence"]},
      "validate": {"network_back": {"verifies": {"contains": {"local": {"properties": {"type": {"const": "testcase"}, "verification_kind": {"const": "e2e"}}, "required": ["verification_kind"]}}, "minContains": 1}}}
    }
  ]
}
